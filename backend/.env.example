PORT=8787
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
# Origin of the catalogue provider (Fake Store API). Put the real address in .env only.
FAKE_STORE_URL=
# CSV file that every enquiry is appended to (created if missing). Defaults to data/enquiries.csv
ENQUIRIES_CSV_PATH=data/enquiries.csv
